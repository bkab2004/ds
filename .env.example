# ─────────────────────────────────────────────────────
# DistriFlow – Environment Variables
# Copy to .env and customize before running
# ─────────────────────────────────────────────────────

# ── MongoDB ─────────────────────────────────────────
MONGODB_URI=mongodb://mongodb:27017
DB_NAME=distriflow

# ── Coordinator ─────────────────────────────────────
COORDINATOR_PORT=50050
HEARTBEAT_TIMEOUT=30        # seconds before a worker is marked FAILED
HEALTH_CHECK_INTERVAL=10    # how often to check worker health (seconds)
SCHEDULE_INTERVAL=2         # how often the task scheduler runs (seconds)
MAX_TASKS_PER_WORKER=5      # max concurrent tasks per worker

# ── Workers ──────────────────────────────────────────
HEARTBEAT_INTERVAL=10       # how often workers send heartbeats (seconds)

# ── Storage ──────────────────────────────────────────
STORAGE_PATH=/storage
MAX_FILE_SIZE_MB=50

# ── API ──────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Frontend (Vite build-time) ───────────────────────
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
